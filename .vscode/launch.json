{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "iOS Debug - Attach",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "program": "${workspaceFolder}/ios/VoxiCal/build/Debug-iphoneos/VoxiCal.app/VoxiCal",
            "iosBundleId": "com.ramya-app.VoxiCal",
            "iosTarget": "select"
        },
        {
            "name": "iOS Logs - Stream (Ramya's iPhone)",
            "type": "node-terminal",
            "request": "launch",
            "command": "idevicesyslog -u 00008150-000A31A03602401C | grep --line-buffered VoxiCal"
        }
    ]
}
