{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build VoxiCal",
            "type": "shell",
            "command": "xcodebuild -project ios/VoxiCal/VoxiCal.xcodeproj -scheme VoxiCal -configuration Debug -destination 'id=00008150-000A31A03602401C' -derivedDataPath /tmp/VoxiCal-build build | xcpretty || true",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy to iPhone",
            "type": "shell",
            "command": "ios-deploy --id 00008150-000A31A03602401C --bundle /tmp/VoxiCal-build/Build/Products/Debug-iphoneos/VoxiCal.app --justlaunch",
            "dependsOn": "Build VoxiCal",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build & Run on iPhone",
            "dependsOn": ["Deploy to iPhone"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Stream iPhone Logs",
            "type": "shell",
            "command": "idevicesyslog -u 00008150-000A31A03602401C | grep --line-buffered -i VoxiCal",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
