{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xcode: Build for Device",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-workspace", "${workspaceFolder}/ios/Hello world.xcodeproj/project.xcworkspace",
        "-scheme", "Hello world",
        "-configuration", "Debug",
        "-destination", "id=00008150-000A31A03602401C",
        "-sdk", "iphoneos",
        "-allowProvisioningUpdates",
        "DEVELOPMENT_TEAM=Q93D62T82F",
        "build"
      ],
      "options": {
        "env": {
          "DEVICE_UDID": "00008150-000A31A03602401C",
          "DEVELOPMENT_TEAM": "Q93D62T82F"
        },
        "cwd": "${workspaceFolder}/ios"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$xcodebuild"]
    },
    {
      "label": "Deploy to iPhone",
      "type": "shell",
      "command": "ios-deploy",
      "args": [
        "--id", "00008150-000A31A03602401C",
        "--bundle", "/Users/ramya/Library/Developer/Xcode/DerivedData/Hello_world-adtylhfvosvwozgclacmtledzigg/Build/Products/Debug-iphoneos/Hello world.app",
        "--justlaunch"
      ],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
